{
  "schema_version": 1,
  "id": "DEV-001",
  "title": "Validate the AlgoOptionX development control plane",
  "implementer": "agent:codex-implementer",
  "requirement_ids": ["HARNESS-01", "HARNESS-02", "HARNESS-03", "HARNESS-04", "HARNESS-05"],
  "allowed_paths": ["harness/", ".agents/", "tests/harness/", "frontend/tests/", "frontend/playwright.config.ts", "frontend/package.json", "frontend/package-lock.json", ".github/", "specs/", "AGENTS.md", "README.md", "pyproject.toml", "uv.lock", ".gitignore"],
  "protected_inputs": ["specs/requirements/development-harness.md"],
  "ui_changes": true,
  "checks": [
    {"id": "python", "kind": "pytest", "argv": [".venv/bin/python", "-m", "pytest", "-q", "-rs", "--junitxml={run_dir}/pytest.xml"], "report": "{run_dir}/pytest.xml", "timeout_seconds": 120,
      "allowed_skips": ["tests.test_prediction.test_levels_sharing_a_price_are_merged_not_dropped"],
      "critical_tests": ["tests.harness.test_control_plane.test_real_human_signatures_and_complete_release_chain", "tests.test_paper_engine.test_kill_flattens_and_blocks_entries"]},
    {"id": "config", "kind": "command", "argv": [".venv/bin/python", "-m", "harness.cli", "validate-config"]},
    {"id": "lint", "kind": "command", "argv": ["npm", "--prefix", "frontend", "run", "lint"]},
    {"id": "build", "kind": "command", "argv": ["npm", "--prefix", "frontend", "run", "build"], "timeout_seconds": 120},
    {"id": "browser", "kind": "playwright", "argv": ["npm", "--prefix", "frontend", "run", "test:all"], "report": "{run_dir}/browser/playwright.json", "timeout_seconds": 180,
      "critical_tests": ["workspace.spec.ts::buy, mark, close and export a virtual trade", "visual.spec.ts::@visual order dialog keyboard state"]}
  ],
  "acceptance": ["Forged or self-issued approvals fail closed", "Failed or zero-test validation cannot become green", "Evidence binds source, logs, reports and independent handoff", "Visual comparisons run without updating snapshots", "No agent can deploy or claim human approval"],
  "rollback": "Stop harness workers, preserve .harness run artifacts and the paper database, then restore the prior compatible code and configuration. Never rewrite trading history."
}
