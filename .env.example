# Copy this file to .env and fill in your real values. Never commit .env.
#
# 1. Log in at https://web.dhan.co
# 2. Go to your profile -> "Access DhanHQ APIs" -> generate an access token.
#    The token is valid for 24 hours from generation.
# 3. Your client ID is shown on the same page.

DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_24h_access_token_here

# ISO timestamp (e.g. 2026-08-22T09:00:00) of when you generated the token above.
# Used only to warn you locally when it's getting close to expiry.
DHAN_TOKEN_ISSUED_AT=2026-08-22T09:00:00
